# Copie para .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard
POSTGRES_PORT=5441

# Backend
BACKEND_PORT=3333
# Host "db" é o nome do serviço no docker-compose
DATABASE_URL=postgresql://flowboard:flowboard@db:5432/flowboard?schema=public
LOG_LEVEL=info
# Troque em qualquer ambiente que não seja dev local (mín. 16 caracteres)
JWT_SECRET=change-me-flowboard-dev-secret
JWT_EXPIRES_IN=7d
# Banco usado pelos testes (é recriado/limpo a cada execução). Se vazio, usa <banco>_test.
TEST_DATABASE_URL=postgresql://flowboard:flowboard@db:5432/flowboard_test?schema=public

# Frontend
FRONTEND_PORT=5150
# Alvo do proxy do Vite para /api (resolvido dentro da rede do Docker)
API_PROXY_TARGET=http://backend:3333
